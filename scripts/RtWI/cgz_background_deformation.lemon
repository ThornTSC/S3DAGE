	// The near shore seems to move every second pixel the foreground moves.
	parallaxShift = -(cameraXPos / 2) % 512
	Renderer.drawCustomSprite("alz_background_nearshore_line192", parallaxShift, 192 - yShift, 0, 0, 0x1100)

