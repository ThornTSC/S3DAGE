	Renderer.drawCustomSprite("alz_bottom3", 0x0a80, 0x0170, 0, SPRITE_FLAG_WORLDSPACE, 0x4001)

	Renderer.drawCustomSprite("alz_bottom0", 0x0600 + 0x0600, 0x0170, 0, SPRITE_FLAG_WORLDSPACE, 0x4001)
}

function void BonusStage.ManageSwitchEffects()
{
	if (global.game.paused)
		return

	// Initialize timer to 0
	if (timer.alldata <= 1)
	{
		bonusSwitchEffectTimer = 0
		fillMemory_u16(0xffff8600 + 2, 2 * bonus.rings.state_table_size - 2, 0xffff)
		return
	}

	// Delete rings if timer is 0
	if (bonusSwitchEffectTimer)
	{
		--bonusSwitchEffectTimer
		if (!bonusSwitchEffectTimer)
		{
			// Final timer sound
			playSound(0xad)

			// Delete stationary rings but not ring sparkles from recently collected rings
			A0 = 0xffff8600
			A1 = A0 + (2 * bonus.rings.state_table_size)
			for (A0; A0 < A1; A0 += 2)
			{
				if (u16[A0] == 0)
				{
					u16[A0] = 0xffff
				}
			}

			// Delete moving rings but not ring sparkles from recently collected rings
			A0 = 0xffffb094
			for (A0; A0 < 0xffffcfcb; A0 += 0x4a)
			{
				if (objA0.update_address == 0x01a88c)
				{
					UnloadObject()
				}
			}
		}

		// Play timer sounds
		if (bonusSwitchEffectTimer == 360 || bonusSwitchEffectTimer == 300 || bonusSwitchEffectTimer == 240 || bonusSwitchEffectTimer == 180 || bonusSwitchEffectTimer == 150  || bonusSwitchEffectTimer == 120 || bonusSwitchEffectTimer == 90 || bonusSwitchEffectTimer == 60  || bonusSwitchEffectTimer == 45  || bonusSwitchEffectTimer == 30  || bonusSwitchEffectTimer == 15)
			playSound(0xa7)
	}

	// Initialize extra rings when switch is hit and set them for removal them seven seconds later. The trap spring is handled separately.
	// Do not reset the timer if it is already running, as this allows easy farming with a Lightning Shield in the CGZ bonus.
	if (level.trigger00 && !bonusSwitchEffectTimer)
	{
		bonusSwitchEffectTimer = 420
		zeroMemory(0xffff8600, 2 * bonus.rings.state_table_size)
	}
}




function void BPZ_CustomSprites()
{
	UpdateBackgroundScrolling.BPZ()		// includes animations in background
	BPZ.AnimateStarPoles()
	BPZ.AnimateForegroundFlags()
	BPZ.DrawLoopCovers()
	BPZ.DrawGiraffeSigns()
	BPZ.DrawSquareFlags()
	BPZ.DrawElephantBlocks()

	// Manage bonus stage timer
	BonusStage.UpdateTimeRemaining()

	// Set goal pole position and render it
	u16 pole.x = 0x0390
	u16 pole.y = 0x00b0
	BonusStage.RenderGoalPole(pole.x, pole.y)
	BonusStage.RenderGoalPole(pole.x - 0x0600, pole.y)
	BonusStage.RenderGoalPole(pole.x - 0x0300, pole.y)
	BonusStage.RenderGoalPole(pole.x + 0x0300, pole.y)
	BonusStage.RenderGoalPole(pole.x + 0x0600, pole.y)

	// Draw bonus bubbles
	BPZ.DrawBonusBubbles()

	// Manage looping and laps
	BPZ.ManageLaps()

	// Manage switch effects
	BonusStage.ManageSwitchEffects()

	// Check for lap bonus award. In this function, we repurpose competition_mode.lap_count.player1 as a field to hold the highest awarded lap bonus
	BonusStage.AwardLapBonus(pole.x)

	// Render LAP BONUS
	BonusStage.RenderLapBonus()

	// The current_lap value tracks the number of times the stage has looped from right to left
	// and decrements whenever the stage loops left to right (backwards).
	// If it's 0 and the player is before the pole or the player1 value is -1, render 0.
	// Otherwise, render the lap_count value plus 1.
	s8 lapNum = clamp(s8(competition_mode.lap_count.player1), 0, 0x7f) + 1
	bool beforePole = (u16[0xffffb010] <= pole.x)
	if (competition_mode.current_lap.player1 >= 0x80 || (lapNum == 1 && beforePole && competition_mode.current_lap.player1 == 0))
		lapNum = 0
	BonusStage.RenderLapNumber(lapNum)
}

function void UpdateBackgroundScrolling.BPZ()
{
	u16 cameraXPos = camera.position.x.u16 + (0x0600 * s8(backgroundCameraLoopCount))
	s64 parallaxShift = -(cameraXPos * 96 / 0x0300) % 512	// line shift calculations can exceed s16 after multiplication and must be done in a larger space
	s32 yShift = 103 * camera.position.y.u16 / 400	// designed to match Sonic Origins vertical shift as closely as possible

	Renderer.drawCustomSprite("bpz_background_stars", parallaxShift, 0 - yShift, 0, 0, 0x1100)

	parallaxShift = -(cameraXPos * 151 / 0x0300) % 512
	Renderer.drawCustomSprite("bpz_background_clouds", parallaxShift, 120 - yShift, 0, 0, 0x1100)

	parallaxShift = -(cameraXPos * 194 / 0x0300) % 512
	Renderer.drawCustomSprite("bpz_background_mountains", parallaxShift, 158 - yShift, 0, 0, 0x1100)

	parallaxShift = -(cameraXPos * 240 / 0x0300) % 512
	Renderer.drawCustomSprite("bpz_background_coasters_far", parallaxShift, 168 - yShift, 0, 0, 0x1100)

	parallaxShift = -(cameraXPos * 288 / 0x0300) % 512
	Renderer.drawCustomSprite("bpz_background_coasters_near", parallaxShift, 208 - yShift, 0, 0, 0x1100)

	parallaxShift = -(cameraXPos * 336 / 0x0300) % 512
	Renderer.drawCustomSprite("bpz_background_treetops_lower", parallaxShift, 224 - yShift, 0, 0, 0x1100)

	parallaxShift = -(cameraXPos / 2) % 512
	Renderer.drawCustomSprite("bpz_background_near", parallaxShift, 232 - yShift, 0, 0, 0x1100)

	// Animate background tent flags
	--animatedTileRender.animationTimer
	if ((animatedTileRender.animationTimer < 0 || timer.alldata == 1) && !global.game.paused)
	{
		animatedTileRender.animationTimer = 5 - 1
		animatedTileRender.animationFrame = !animatedTileRender.animationFrame
	}
	Renderer.drawCustomSprite(stringformat("bpz_tentflags_frame%d", animatedTileRender.animationFrame), parallaxShift, 240 - yShift, 0, 0, 0x1100)

	// Animate background yellow dot lights
	--animatedTileRender2.animationTimer
	if ((animatedTileRender2.animationTimer < 0 || timer.alldata == 1) && !global.game.paused)
	{
		animatedTileRender2.animationTimer = 3 - 1
		animatedTileRender2.animationFrame = !animatedTileRender2.animationFrame
	}
	Renderer.drawCustomSprite(stringformat("bpz_yellowdots_frame%d", animatedTileRender2.animationFrame), parallaxShift, 296 - yShift, 0, 0, 0x1100)

	// Tint the background just a bit to complement the Revisited palette.
	if (palette_set >= 2)
		Renderer.drawCustomSprite("whitescreen", 0, 0, 0, SPRITE_FLAG_PRIO, 0x1101, 0, 0x0c4000ff, 0x10000)
}

function void BPZ.AnimateStarPoles()
{
	--animatedTileRender3.animationTimer
	if ((animatedTileRender3.animationTimer < 0 || timer.alldata == 1) && !global.game.paused)
	{
		animatedTileRender3.animationTimer = 6 - 1
		animatedTileRender3.animationFrame = (animatedTileRender3.animationFrame + 1) % 5
	}
	u8 frameToDraw = animatedTileRender3.animationFrame
	u8 flags = SPRITE_FLAG_WORLDSPACE
	if (frameToDraw == 3)
	{
		frameToDraw = 2
		flags |= SPRITE_FLAG_FLIP_X
	}
	else if (frameToDraw == 4)
	{
		frameToDraw = 1
		flags |= SPRITE_FLAG_FLIP_X
	}

	Renderer.drawCustomSprite(stringformat("bpz_starpole_short_frame%d", frameToDraw), 0x0360 - 0x0300, 0x00e6, 0, flags, 0x3001)
	Renderer.drawCustomSprite(stringformat("bpz_starpole_long_frame%d", frameToDraw), 0x0360 - 0x0300, 0x02d2, 0, flags, 0x3001)

	Renderer.drawCustomSprite(stringformat("bpz_starpole_long_frame%d", frameToDraw), 0x02d0, 0x01fa, 0, flags, 0x3001)
	Renderer.drawCustomSprite(stringformat("bpz_starpole_short_frame%d", frameToDraw), 0x0360, 0x00e6, 0, flags, 0x3001)
	Renderer.drawCustomSprite(stringformat("bpz_starpole_long_frame%d", frameToDraw), 0x0360, 0x02d2, 0, flags, 0x3001)

	Renderer.drawCustomSprite(stringformat("bpz_starpole_long_frame%d", frameToDraw), 0x02d0 + 0x0300, 0x01fa, 0, flags, 0x3001)
	Renderer.drawCustomSprite(stringformat("bpz_starpole_short_frame%d", frameToDraw), 0x0360 + 0x0300, 0x00e6, 0, flags, 0x3001)
	Renderer.drawCustomSprite(stringformat("bpz_starpole_long_frame%d", frameToDraw), 0x0360 + 0x0300, 0x02d2, 0, flags, 0x3001)

	Renderer.drawCustomSprite(stringformat("bpz_starpole_long_frame%d", frameToDraw), 0x02d0 + 0x0600, 0x01fa, 0, flags, 0x3001)
	Renderer.drawCustomSprite(stringformat("bpz_starpole_short_frame%d", frameToDraw), 0x0360 + 0x0600, 0x00e6, 0, flags, 0x3001)
	Renderer.drawCustomSprite(stringformat("bpz_starpole_long_frame%d", frameToDraw), 0x0360 + 0x0600, 0x02d2, 0, flags, 0x3001)
}

function void BPZ.AnimateForegroundFlags()
{
	--animatedTileRender4.animationTimer
	if ((animatedTileRender4.animationTimer < 0 || timer.alldata == 1) && !global.game.paused)
	{
		animatedTileRender4.animationTimer = 8 - 1
		animatedTileRender4.animationFrame = (animatedTileRender4.animationFrame + 1) % 6
	}

	
	Renderer.drawCustomSprite(stringformat("bpz_foregroundflags_frame%d", animatedTileRender4.animationFrame), 0x036c - 0x0300, 0x0158, 0, SPRITE_FLAG_WORLDSPACE, 0x3001)

	Renderer.drawCustomSprite(stringformat("bpz_foregroundflags_frame%d", animatedTileRender4.animationFrame), 0x024c, 0x00c8, 0, SPRITE_FLAG_WORLDSPACE, 0x3001)
