function void BonusStage.UpdateTimeRemaining()
{
	if (timer.alldata == 1)
		BS_remainingTime = 2700 - 1
	else if (BS_remainingTime != 0 && !global.game.paused && !freeze_time)
		--BS_remainingTime

	// Draw the timer
	s16 px_timer = getScreenWidth() / 2
	constant u16 timer_screentop = 12
	constant u16 timer_screenbottom = 196		// getScreenHeight() of 224, minus 12 for empty space below HUD, minus 16 for height of digits
	s16 py_timer = timer_screentop
	u16 renderQueue_hud = 0xe800

	u32 alpha = ((freeze_time >= 64) ? 255 : (freeze_time * 4)) // << 24		// shift needed if using Sonic 2 special digits

	u16 seconds = BS_remainingTime / 60
	u16 frames = BS_remainingTime - (seconds * 60)
	u16 centiseconds = (frames * 99 + 30) / 59

	if (seconds > 99)
	{
		seconds = 99
		centiseconds = 99
	}

//	Renderer.drawCustomSprite("sonic2_timeframe", px_timer, py_timer + 6 + 32, 0, SPRITE_FLAG_PRIO, renderQueue_hud)

	// Normal digits
//	Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d", seconds / 10), px_timer - 17, py_timer + 32, 0, SPRITE_FLAG_PRIO, renderQueue_hud)
//	Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d", seconds % 10), px_timer - 9, py_timer + 32, 0, SPRITE_FLAG_PRIO, renderQueue_hud)
//	Renderer.drawCustomSprite("sonic2_specialdigit_period", px_timer - 2, py_timer + 32, 0, SPRITE_FLAG_PRIO, renderQueue_hud)
//	Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d_mini", centiseconds / 10), px_timer + 2, py_timer + 4 + 32, 0, SPRITE_FLAG_PRIO, renderQueue_hud)
//	Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d_mini", centiseconds % 10), px_timer + 10, py_timer + 4 + 32, 0, SPRITE_FLAG_PRIO, renderQueue_hud)

	Renderer.drawCustomSprite(stringformat("bonus_timer_large_%d", seconds / 10), px_timer - 31, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud)
	Renderer.drawCustomSprite(stringformat("bonus_timer_large_%d", seconds % 10), px_timer - 15, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud)
	Renderer.drawCustomSprite("bonus_timer_large_period", px_timer + 1, py_timer + 18, 0, SPRITE_FLAG_PRIO, renderQueue_hud)
	Renderer.drawCustomSprite(stringformat("bonus_timer_small_%d", centiseconds / 10), px_timer + 8, py_timer + 8, 0, SPRITE_FLAG_PRIO, renderQueue_hud)
	Renderer.drawCustomSprite(stringformat("bonus_timer_small_%d", centiseconds % 10), px_timer + 20, py_timer + 8, 0, SPRITE_FLAG_PRIO, renderQueue_hud)	

	// Time running out digits
	if (BS_remainingTime <= 600 && (level.framecounter.low & 0x08) && !freeze_time)
	{
	//	Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d_red", seconds / 10), px_timer - 17, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1)
	//	Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d_red", seconds % 10), px_timer - 9, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1)
	//	Renderer.drawCustomSprite("sonic2_specialdigit_period_red", px_timer - 2, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1)
	//	Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d_mini_red", centiseconds / 10), px_timer + 2, py_timer + 4, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1)
	//	Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d_mini_red", centiseconds % 10), px_timer + 10, py_timer + 4, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1)

		Renderer.drawCustomSprite(stringformat("bonus_timer_large_%d", seconds / 10), px_timer - 31, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, 0xff4040ff, 0x10000)
		Renderer.drawCustomSprite(stringformat("bonus_timer_large_%d", seconds % 10), px_timer - 15, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, 0xff4040ff, 0x10000)
		Renderer.drawCustomSprite("bonus_timer_large_period", px_timer + 1, py_timer + 18, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, 0xff4040ff, 0x10000)
		Renderer.drawCustomSprite(stringformat("bonus_timer_small_%d", centiseconds / 10), px_timer + 8, py_timer + 8, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, 0xff4040ff, 0x10000)
		Renderer.drawCustomSprite(stringformat("bonus_timer_small_%d", centiseconds % 10), px_timer + 20, py_timer + 8, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, 0xff4040ff, 0x10000)	
	}

	// Time freeze digits
	if (freeze_time)
	{
//		Renderer.drawCustomSprite("sonic2_timeframe", px_timer, py_timer + 6, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, alpha + 0x00ffff00, 0x10000)
//		Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d", seconds / 10), px_timer - 17, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 2, 0, alpha + 0x00ff00e0, 0x10000)
//		Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d", seconds % 10), px_timer - 9, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 2, 0, alpha + 0x00ff00e0, 0x10000)
//		Renderer.drawCustomSprite("sonic2_specialdigit_period", px_timer - 2, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 2, 0, alpha + 0x00ff00e0, 0x10000)
//		Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d_mini", centiseconds / 10), px_timer + 2, py_timer + 4, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 2, 0, alpha + 0x00ff00e0, 0x10000)
//		Renderer.drawCustomSprite(stringformat("sonic2_specialdigit_%d_mini", centiseconds % 10), px_timer + 10, py_timer + 4, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 2, 0, alpha + 0x00ff00e0, 0x10000)

		Renderer.drawCustomSprite(stringformat("bonus_timer_large_%d_purple", seconds / 10), px_timer - 31, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, alpha)
		Renderer.drawCustomSprite(stringformat("bonus_timer_large_%d_purple", seconds % 10), px_timer - 15, py_timer, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, alpha)
		Renderer.drawCustomSprite("bonus_timer_large_period_purple", px_timer + 1, py_timer + 18, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, alpha)
		Renderer.drawCustomSprite(stringformat("bonus_timer_small_%d_purple", centiseconds / 10), px_timer + 8, py_timer + 8, 0, SPRITE_FLAG_PRIO, renderQueue_hud + 1, 0, alpha)
		Renderer.drawCustomSprite(stringformat("bonus_timer_small_%d_purple", centiseconds % 10), px_timer + 20, py_timer + 8, 0, SPRITE_FLAG_PRIO, renderQueue_hud +1, 0, alpha)	
	}

	if (timer.alldata > 1 && !BS_remainingTime)
	{
		BonusStage.Exit()
	}
}

function void BonusStage.Exit()
{
	bonus_stage.exiting = 1
	global.zone_act = checkpoint.zone_act
	global.zone_act.apparent = checkpoint.zone_act.apparent
	checkpoint.number = checkpoint.number.backup
	global.stage_type = 0
	level.restart.u8 = 2		// make a special flag that says to clear unlock_act *after* the palette fully fades, to avoid displaying improper art. We manage this flag in initializeMainGame(), which runs on the frame the zone loads.
	checkpoint.rings = ring_counter
	checkpoint.lives_granted = extra_lives_granted
	global.shields_backup_1 = u8[0xffffb000 + 0x2b] & char.bonus.ALL_SHIELDS	
	if (u8[0xffffe654])			// with some extra slot characters, though, we don't have the luxury of using initializeMainGame(), so these characters just have to deal with the art oddity
		unlock_act = 0
}

function void BonusStage.RenderLapNumber(u8 lapNum)
{
	u16 px = getScreenWidth() - 56
	u16 py = 12
	if (HUD.useMobileLivesDisplay())
	{
		py = getScreenHeight() - 32
		if (time_attack == 3)	// emerald HUD is displayed
			py -= 24
	}
	for (u32 value = lapNum;;)
	{
		Renderer.drawCustomSprite(stringformat("lap_%d", value % 10), px, py, 0x00, SPRITE_FLAG_PRIO, 0xe800)
		px -= 16
		value /= 10
		if (value == 0)
			break
	}
}

function bool BonusStage.IsNewLap(u16 pole.x)
{
	return (u16[0xffffb010] >= pole.x && s8(competition_mode.current_lap.player1) > competition_mode.lap_count.player1 && s8(competition_mode.current_lap.player1) > 0)
}

function bool BPZ.IsNewLap(u16 pole.x)
{
//	debugLog(stringformat("Player X: %x", u16[0xffffb010]))
//	debugLog(stringformat("Pole X: %x", pole.x))
//	debugLog(stringformat("Internal lap count: %x", competition_mode.current_lap.player1))
//	debugLog(stringformat("Player laps completed: %x", competition_mode.lap_count.player1))
//	debugLog(stringformat("Is second half lap: %x", u16[0xffffb010] >= pole.x + 0x0300))

	if (u16[0xffffb010] < pole.x + 0x80 && (competition_mode.lap_count.player1 & 0x01))	// the + 0x80 allows a buffer in which we actually cross the pole during the check
	{
//		debugLog("Check 1")
		return (u16[0xffffb010] >= pole.x && s8(2*competition_mode.current_lap.player1) > competition_mode.lap_count.player1 && s8(competition_mode.current_lap.player1) > 0)
	}
	else
	{
//		debugLog("Check 2")
		return (u16[0xffffb010] >= pole.x + 0x0300 && s8(2*competition_mode.current_lap.player1 + 1) > competition_mode.lap_count.player1)
	}
}

constant array<u16> BonusStage.LapBonuses =
{
	5, 5, 10, 10, 15, 15, 20, 20, 25, 25
}

function void BonusStage.AwardLapBonus(u16 pole.x)
{
	// Initialize the variable for tracking laps for background deformation
	if (timer.alldata == 1)
		backgroundCameraLoopCount = 0

	// A new lap has started if the player is to the right of the pole, the current internal lap is greater than the displayed lap, and the lap counter isn't zero.
	// BPZ maps two visual laps to one internal lap, requiring slightly different logic.
	if (unlock_act != s3_BPZ && !BonusStage.IsNewLap(pole.x))
		return
	if (unlock_act == s3_BPZ && !BPZ.IsNewLap(pole.x))
		return

	ring_counter += BonusStage.LapBonuses[min(competition_mode.lap_count.player1, 9)]
	hud.dirty.rings = 0x80
	if (checkForExtraLifeByRings())
	{
		gainExtraLife()
	}
	playSound(0x63)		// star post trigger sound
	if (competition_mode.lap_count.player1 != 0x7f)
		++competition_mode.lap_count.player1
	u8[0xfffffff1] = 120	// use the free byte after level.start_location as a timer to display the LAP BONUS
}

function void BonusStage.RenderLapBonus()
{
	if (u8[0xfffffff1])	// LAP BONUS display timer
	{
		if (!global.game.paused)
			--u8[0xfffffff1]	// decrement timer
		u16 currentRingBonus = BonusStage.LapBonuses[min(competition_mode.lap_count.player1 - 1, 9)]

		if (theme.hud == theme.saturn)
			Saturn.displayLapBonus(currentRingBonus)
		else if (theme.hud == theme.flicky)
			Flicky.displayLapBonus(currentRingBonus)
		else if (theme.hud == theme.south)
			South.displayLapBonus(currentRingBonus)
		else if (theme.hud == theme.westside)
			Westside.displayLapBonus(currentRingBonus)

		else if (currentRingBonus < 10)
		{
			Renderer.drawCustomSprite("hud_ring", u16[0xffffb010] - 19, u16[0xffffb014] - 39, 0x00, SPRITE_FLAG_PRIO | SPRITE_FLAG_WORLDSPACE, 0xc002)	
			Renderer.drawCustomSprite("angel_hud_plus", u16[0xffffb010], u16[0xffffb014] - 37, 0x00, SPRITE_FLAG_PRIO | SPRITE_FLAG_WORLDSPACE, 0xc002)	
			Renderer.drawCustomSprite(stringformat("hud_digit_%d", currentRingBonus % 10), u16[0xffffb010] + 10, u16[0xffffb014] - 37, 0x00, SPRITE_FLAG_PRIO | SPRITE_FLAG_WORLDSPACE, 0xc002)
		}
		else
		{
			Renderer.drawCustomSprite("hud_ring", u16[0xffffb010] - 23, u16[0xffffb014] - 39, 0x00, SPRITE_FLAG_PRIO | SPRITE_FLAG_WORLDSPACE, 0xc002)	
			Renderer.drawCustomSprite("angel_hud_plus", u16[0xffffb010] - 4, u16[0xffffb014] - 37, 0x00, SPRITE_FLAG_PRIO | SPRITE_FLAG_WORLDSPACE, 0xc002)	
			Renderer.drawCustomSprite(stringformat("hud_digit_%d", currentRingBonus / 10), u16[0xffffb010] + 6, u16[0xffffb014] - 37, 0x00, SPRITE_FLAG_PRIO | SPRITE_FLAG_WORLDSPACE, 0xc002)
			Renderer.drawCustomSprite(stringformat("hud_digit_%d", currentRingBonus % 10), u16[0xffffb010] + 14, u16[0xffffb014] - 37, 0x00, SPRITE_FLAG_PRIO | SPRITE_FLAG_WORLDSPACE, 0xc002)
		}

	// Old method using built-in fonts instead of theme-specific PNG sprites
		// u16 ringX = (currentRingBonus < 10) ? -19 : -21
		// u16 textX = 9 // (currentRingBonus < 10) ? 9 : 9
		// Renderer.drawCustomSprite("hud_ring", u16[0xffffb010] + ringX, u16[0xffffb014] - 39, 0x00, SPRITE_FLAG_PRIO | SPRITE_FLAG_WORLDSPACE, 0x9f01)	
		// Renderer.drawText("sonic_r_credits_small:shadow(1,1,0,1)", u16[0xffffb010] + textX, u16[0xffffb014] - 36, stringformat("+ %d", currentRingBonus), 0xffffffff, 2, 0, 0x9f01, 1, 1)
	}
}






function void ALZ_CustomSprites()
{
	UpdateBackgroundScrolling.ALZ()
	ALZ.AnimateTar()
	ALZ.DisplayLeaves()
	ALZ.DisplayBottom()

	Renderer.addSpriteMaskWorld(0x03f0, 0x0150, 0x05a0, 0x0030, 0xc000, 1)
	Renderer.addSpriteMaskWorld(0x0540, 0x0000, 0x0030, 0x0100, 0xc000, 1)

	Renderer.addSpriteMaskWorld(0x09f0, 0x0150, 0x05a0, 0x0030, 0xc000, 1)
	Renderer.addSpriteMaskWorld(0x0b40, 0x0000, 0x0030, 0x0100, 0xc000, 1)

	// Manage bonus stage timer
	BonusStage.UpdateTimeRemaining()

	// Set goal pole position and render it
	u16 pole.x = 0x0660
	u16 pole.y = 0x00f0
	BonusStage.RenderGoalPole(pole.x, pole.y)
	BonusStage.RenderGoalPole(pole.x - 0x0600, pole.y)
	BonusStage.RenderGoalPole(pole.x + 0x0600, pole.y)

	// Draw bonus bubbles
	ALZ.DrawBonusBubbles()

	// Manage looping and laps
	ALZ.ManageLaps()

	// Manage switch effects
	BonusStage.ManageSwitchEffects()

	// Check for lap bonus award. In this function, we repurpose competition_mode.lap_count.player1 as a field to hold the highest awarded lap bonus
	BonusStage.AwardLapBonus(pole.x)

	// Render LAP BONUS
	BonusStage.RenderLapBonus()

	// The current_lap value tracks the number of times the stage has looped from right to left
	// and decrements whenever the stage loops left to right (backwards).
	// If it's 0 and the player is before the pole or the player1 value is -1, render 0.
	// Otherwise, render the lap_count value plus 1.
	s8 lapNum = clamp(s8(competition_mode.lap_count.player1), 0, 0x7f) + 1
	bool beforePole = (u16[0xffffb010] <= pole.x)
	if (competition_mode.current_lap.player1 >= 0x80 || (lapNum == 1 && beforePole && competition_mode.current_lap.player1 == 0))
		lapNum = 0
	BonusStage.RenderLapNumber(lapNum)

	// ALZ has so many tiles that they overwrite spikes and springs in VRAM, leading to temporary graphics corruption when leaving the stage.
	// To circumvent this, we leave a space in the tiles for this art to load before returning to the normal act.
	if (timer.alldata == 1 && !global.game.paused)
		Nemesis.loadDataToVRAM(0x1927fe, 0x9280)
}

function void UpdateBackgroundScrolling.ALZ()
{
	u16 cameraXPos = camera.position.x.u16 + (0x0600 * s8(backgroundCameraLoopCount))
	s64 parallaxShift = 0 // -(cameraXPos * 120 / 0x1ff0) % 512	// line shift calculations can exceed s16 after multiplication and must be done in a larger space
	s16 yShift = camera.position.y.u16 / 9	- 8	// designed to match Sonic Origins vertical shift as closely as possible

	Renderer.drawCustomSprite("alz_background_sky_line0", parallaxShift, -16 - yShift, 0, 0, 0x1100)
	Renderer.drawCustomSprite("alz_background_sky_line0", parallaxShift, 0 - yShift, 0, 0, 0x1100)

	// The highest layer of clouds moves one pixel to the left every 3 frames.
	parallaxShift = -((cameraXPos * 40 / 0x0600) + (level.framecounter / 3)) % 512
	Renderer.drawCustomSprite("alz_background_clouds_line16", parallaxShift, 16 - yShift, 0, 0, 0x1100)

	// The second-lowest layer of clouds moves one pixel to the left every 12 frames.
	parallaxShift = -((cameraXPos * 8 / 0x0600) + (level.framecounter / 12)) % 512
	Renderer.drawCustomSprite("alz_background_clouds_line24", parallaxShift, 24 - yShift, 0, 0, 0x1100)

	// The third-highest layer of clouds moves one pixel to the left every 3 frames.
	parallaxShift = -((cameraXPos * 48 / 0x0600) + (level.framecounter / 3)) % 512
	Renderer.drawCustomSprite("alz_background_clouds_line32", parallaxShift, 32 - yShift, 0, 0, 0x1100)

	// The third-lowest layer of clouds moves one pixel to the left every 7 frames.
	parallaxShift = -((cameraXPos * 36 / 0x0600) + (level.framecounter / 7)) % 512
	Renderer.drawCustomSprite("alz_background_clouds_line40", parallaxShift, 40 - yShift, 0, 0, 0x1100)

	// The second-lowest layer of clouds moves one pixel to the left every 4 frames.
	parallaxShift = -((cameraXPos * 48 / 0x0600) + (level.framecounter / 4)) % 512
	Renderer.drawCustomSprite("alz_background_clouds_line48", parallaxShift, 48 - yShift, 0, 0, 0x1100)

	// The lowest layer of clouds moves one pixel to the left every 8 frames.
	parallaxShift = -((cameraXPos * 64 / 0x0600) + (level.framecounter / 8)) % 512
	Renderer.drawCustomSprite("alz_background_clouds_line56", parallaxShift, 56 - yShift, 0, 0, 0x1100)



	// Mountains move 96 (0x60) pixels per loop of the stage (0x0600 long)
	parallaxShift = -(cameraXPos * 96 / 0x0600) % 512
	Renderer.drawCustomSprite("alz_background_mountains_line64", parallaxShift, 64 - yShift, 0, 0, 0x1100)



	// Farther trees across the lake move approximately 120 (0x78) pixels per loop of the stage (0x0600 long)
	parallaxShift = -(cameraXPos * 120 / 0x0600) % 512
	Renderer.drawCustomSprite("alz_background_fartrees_line110", parallaxShift, 110 - yShift, 0, 0, 0x1100)

	// Nearer trees across the lake move exactly 144 (0x90) pixels per loop of the stage (0x0600 long)
	parallaxShift = -(cameraXPos * 144 / 0x0600) % 512
	Renderer.drawCustomSprite("alz_background_neartrees_line116", parallaxShift, 116 - yShift, 0, 0, 0x1100)


	// The lake uses the nearer trees' scrolling when reflecting trees and the mountains' scrolling when reflecting mountains.
	s64 rippleShiftIndex = (level.framecounter / 8) % 66	// Sonic 2 uses u8[0xfffffe0f], a.k.a. global.framecounter.low. Same address in S2 and S3. We use level.framecounter since that pauses with DAGE pausing.

	Renderer.drawCustomSprite("alz_background_lake_line132", parallaxShift + SwScrl_RippleData[(rippleShiftIndex +  0) % 66], 132 - yShift, 0, 0, 0x1100)
	Renderer.drawCustomSprite("alz_background_lake_line133", parallaxShift + SwScrl_RippleData[(rippleShiftIndex +  1) % 66], 133 - yShift, 0, 0, 0x1100)
	Renderer.drawCustomSprite("alz_background_lake_line134", parallaxShift + SwScrl_RippleData[(rippleShiftIndex +  2) % 66], 134 - yShift, 0, 0, 0x1100)
	
	parallaxShift = -(cameraXPos * 96 / 0x0600) % 512
	Renderer.drawCustomSprite("alz_background_lake_line135", parallaxShift + SwScrl_RippleData[(rippleShiftIndex +  3) % 66], 135 - yShift, 0, 0, 0x1100)
	// Line 135 and 136 are combined into one image, as line 135 is simply a solid horizontal line of one color.
	Renderer.drawCustomSprite("alz_background_lake_line137", parallaxShift + SwScrl_RippleData[(rippleShiftIndex +  5) % 66], 137 - yShift, 0, 0, 0x1100)
	Renderer.drawCustomSprite("alz_background_lake_line138", parallaxShift + SwScrl_RippleData[(rippleShiftIndex +  6) % 66], 138 - yShift, 0, 0, 0x1100)
