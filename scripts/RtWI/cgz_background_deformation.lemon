function void ALZ.AnimateTar()
{
	--animatedTileRender.animationTimer
	if ((animatedTileRender.animationTimer < 0 || timer.alldata == 1) && !global.game.paused)
	{
		animatedTileRender.animationTimer = 10 - 1
		animatedTileRender.animationFrame = (animatedTileRender.animationFrame + 1) % 3
	}
	Renderer.drawCustomSprite(stringformat("alz_tar_frame%d", animatedTileRender.animationFrame), 0x0990, 0x0130, 0, SPRITE_FLAG_WORLDSPACE, 0xa001)
	Renderer.drawCustomSprite(stringformat("alz_tar_frame%d", animatedTileRender.animationFrame), 0x09c0, 0x0130, 0, SPRITE_FLAG_WORLDSPACE, 0xa001)
	Renderer.drawCustomSprite("alz_tar_bottom", 0x0990, 0x0177, 0, SPRITE_FLAG_WORLDSPACE, 0xa001)
}

