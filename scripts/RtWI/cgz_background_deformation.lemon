function void BPZ.DrawElephantBlocks()
{
	u32 backupA0 = A0
	A0 = 0xffffb094
	for (A0; A0 < 0xffffcfcb; A0 += 0x4a)
	{
		if (objA0.update_address == 0x035c72 || objA0.update_address == 0x035cca)
		{
			bool prioFlag = (objA0.sprite_attributes & 0x8000) != 0
			u16 elephantXpos = (objA0.render_flags & 0x01) ? objA0.position.x.u16 + objA0.box_size.x + (u8[A0 + 0x34] & 0x01) : objA0.position.x.u16 - objA0.box_size.x - (u8[A0 + 0x34] & 0x01)
			u16 renderQueue = 0xa000
			Renderer.drawCustomSprite("bpz_elephantblock", elephantXpos, objA0.position.y.u16, 0x00, (prioFlag ? SPRITE_FLAG_PRIO : 0) + (objA0.render_flags & 0x01) + SPRITE_FLAG_WORLDSPACE, renderQueue)
			Renderer.drawCustomSprite("bpz_elephanttusk", u16[A0 + 0x30] + ((objA0.render_flags & 0x01) ? -12 : 12), objA0.position.y.u16 + 12, 0x00, SPRITE_FLAG_PRIO + (objA0.render_flags & 0x01) + SPRITE_FLAG_WORLDSPACE, 0xa001)
			// Render object in other laps of the BPZ bonus stage. Unlockable act ID checked in case this is used outside of bonus stage in the future.
			if (unlock_act == s3_BPZ)
			{
				Renderer.drawCustomSprite("bpz_elephantblock", elephantXpos - 0x0600, objA0.position.y.u16, 0x00, (prioFlag ? SPRITE_FLAG_PRIO : 0) + (objA0.render_flags & 0x01) + SPRITE_FLAG_WORLDSPACE, renderQueue)
				Renderer.drawCustomSprite("bpz_elephantblock", elephantXpos - 0x0300, objA0.position.y.u16, 0x00, (prioFlag ? SPRITE_FLAG_PRIO : 0) + (objA0.render_flags & 0x01) + SPRITE_FLAG_WORLDSPACE, renderQueue)
				Renderer.drawCustomSprite("bpz_elephantblock", elephantXpos + 0x0300, objA0.position.y.u16, 0x00, (prioFlag ? SPRITE_FLAG_PRIO : 0) + (objA0.render_flags & 0x01) + SPRITE_FLAG_WORLDSPACE, renderQueue)
				Renderer.drawCustomSprite("bpz_elephantblock", elephantXpos + 0x0600, objA0.position.y.u16, 0x00, (prioFlag ? SPRITE_FLAG_PRIO : 0) + (objA0.render_flags & 0x01) + SPRITE_FLAG_WORLDSPACE, renderQueue)
			}
		}
	}
	A0 = backupA0
}




function void CGZ_CustomSprites()
{
	UpdateBackgroundScrolling.CGZ()

	// Manage bonus stage timer
	BonusStage.UpdateTimeRemaining()

	// Set goal pole position and render it
	u16 pole.x = 0x0690
	u16 pole.y = 0x02a0
	BonusStage.RenderGoalPole(pole.x, pole.y)

	// Draw bonus bubbles
	CGZ.DrawBonusBubbles()

	// Manage looping and laps
	CGZ.ManageLaps()

	// Manage switch effects
	BonusStage.ManageSwitchEffects()

	// Check for lap bonus award. In this function, we repurpose competition_mode.lap_count.player1 as a field to hold the highest awarded lap bonus
	BonusStage.AwardLapBonus(pole.x)

	// Render LAP BONUS
	BonusStage.RenderLapBonus()

	// If it's 0 and the player is before the pole or the player1 value is -1, render 0.
	// Otherwise, render the player2 value plus 1.
	s8 lapNum = clamp(s8(competition_mode.lap_count.player1), 0, 0x7f) + 1
	bool underStart = (u16[0xffffb010] > 0x0600 && u16[0xffffb010] < pole.x && u16[0xffffb014] < 0x02a8)
	bool beforeStart = (u16[0xffffb010] <= 0x0600)
	if (competition_mode.current_lap.player1 == 0xff || (lapNum == 1 && (underStart || beforeStart) && competition_mode.current_lap.player1 == 0))
		lapNum = 0
	BonusStage.RenderLapNumber(lapNum)
}

function void UpdateBackgroundScrolling.CGZ()
{
	u16 cameraXPos = camera.position.x.u16 + 0x4000 + (0x600 * s8(backgroundCameraLoopCount))		// we use a camera shift to stop the moon from scrolling off screen early
	s64 parallaxShift = -(cameraXPos * 120 / 0x1ff0) % 512	// line shift calculations can exceed s16 after multiplication and must be done in a larger space
	s16 yShift = 0 // camera.position.y.u16 / 56	// -8						// 56 is chosen for an appropriate amount of vertical scroll. -8 represents 8 pixels of extra sky shown above the usual highest point. Alt idea: 28 and -32
	Renderer.drawCustomSprite("cgz_background_sky", parallaxShift, 0 - yShift, 0, 0, 0x1100)
	parallaxShift = -(cameraXPos * 240 / 0x1ff0) % 512
	Renderer.drawCustomSprite("cgz_background_lights_veryfar", parallaxShift, 48 - yShift, 0, 0, 0x1100)
	parallaxShift = -(cameraXPos * 480 / 0x1ff0) % 512
	Renderer.drawCustomSprite("cgz_background_buildings_far", parallaxShift, 88 - yShift, 0, 0, 0x1100)
	parallaxShift = -(cameraXPos * 960 / 0x1ff0) % 512
	Renderer.drawCustomSprite("cgz_background_buildings_mid", parallaxShift, 104 - yShift, 0, 0, 0x1100)
	parallaxShift = -(cameraXPos * 1920 / 0x1ff0) % 512
	Renderer.drawCustomSprite("cgz_background_buildings_near", parallaxShift, 120 - yShift, 0, 0, 0x1100)

	// Tint the background just a bit to complement the Revisited palette.
	if (palette_set >= 2)
		Renderer.drawCustomSprite("whitescreen", 0, 0, 0, SPRITE_FLAG_PRIO, 0x1101, 0, 0x20400080, 0x10000)
}

function void ALZ.ManageLaps()
{
	u8[0xffffb037] |= 0x80		// set a flag saying the character cannot be hurt, although they can be knocked back
	// If too far right
	if (u16[0xffffb010] > 0x0660 + 0x0600)
	{
		u16[0xffffb010] -= 0x0600
		u16[0xffffb010 + 0x4a] -= 0x0600
		camera.position.x.u16 -= 0x0600
		camera.foreground.x.u16 -= 0x0600
		fillPlaneA_Default(camera.foreground.x.u16 - 0x40, camera.foreground.y.u16 - 0x40, getScreenWidth() + 0x80, getScreenHeight() + 0x80)
		Level.GetCameraPosition()
		++backgroundCameraLoopCount
		++competition_mode.current_lap.player1
		if (competition_mode.current_lap.player1 < competition_mode.lap_count.player1)	// we went backwards for more than one lap and then started forward again
			competition_mode.current_lap.player1 = competition_mode.lap_count.player1	// in this case, act like we only went backwards one lap so the next forward lap counts
		for (u16 offset = 0; offset < 0x100; offset += 4)	// change the previous player 1 position table to prevent camera glitches with dashes
		{
			u16[0xffffe500 + offset] -= 0x0600
		}

		// Shift any moving rings or lightning shield sparks with the player character
		A0 = 0xffffb094
		for (A0; A0 < 0xffffcfcb; A0 += 0x4a)
		{
			if (objA0.update_address == 0x01a88c || objA0.update_address == 0x01a920 || objA0.update_address == 0x019874)
			{
				objA0.position.x.u16 -= 0x0600
			}
		}
		// Shift shield with player, else it vanishes for one frame
		u16[0xffffcce8 + 0x10] -= 0x0600
	}
	// If too far left
	else if (u16[0xffffb010] < 0x0660)
	{
		u16[0xffffb010] += 0x0600
		u16[0xffffb010 + 0x4a] += 0x0600
		camera.position.x.u16 += 0x0600
		camera.foreground.x.u16 += 0x0600
		fillPlaneA_Default(camera.foreground.x.u16 - 0x40, camera.foreground.y.u16 - 0x40, getScreenWidth() + 0x80, getScreenHeight() + 0x80)
		Level.GetCameraPosition()
		--backgroundCameraLoopCount
		if (competition_mode.current_lap.player1 != 0xff)
			--competition_mode.current_lap.player1
		for (u16 offset = 0; offset < 0x100; offset += 4)	// change the previous player 1 position table to prevent camera glitches with dashes
		{
			u16[0xffffe500 + offset] += 0x0600
		}

		// Shift any moving rings or lightning shield sparks with the player character
		A0 = 0xffffb094
		for (A0; A0 < 0xffffcfcb; A0 += 0x4a)
		{
			if (objA0.update_address == 0x01a88c || objA0.update_address == 0x01a920 || objA0.update_address == 0x019874)
			{
				objA0.position.x.u16 += 0x0600
			}
		}
		// Shift shield with player, else it vanishes for one frame
		u16[0xffffcce8 + 0x10] += 0x0600
	}
}

function void BPZ.ManageLaps()
{
	u8[0xffffb037] |= 0x80		// set a flag saying the character cannot be hurt, although they can be knocked back
	// If too far right
	if (u16[0xffffb010] > 0x0280 + 0x0600)
	{
		u16[0xffffb010] -= 0x0600
		u16[0xffffb010 + 0x4a] -= 0x0600
