	Renderer.drawCustomSprite("alz_leaves_start", 0x0600, 0x0000, 0, SPRITE_FLAG_WORLDSPACE, 0xa001)
	Renderer.drawCustomSprite("alz_leaves_loop", 0x07e0, 0x0000, 0, SPRITE_FLAG_WORLDSPACE, 0xa001)
